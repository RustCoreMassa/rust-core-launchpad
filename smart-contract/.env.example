# Private key of the deployer — it becomes the Launchpad admin. Never commit .env.
PRIVATE_KEY=

# buildnet (default) or mainnet
NETWORK=buildnet

# Launchpad config at deploy time (MAS, except the presale fee in basis points).
# Defaults are small test values for buildnet; mainnet values are still to be decided.
TOKEN_FEE_MAS=1
COLLECTION_FEE_MAS=1
IMPORT_FEE_MAS=0.5
PRESALE_FEE_BPS=200
DEPLOY_DEPOSIT_MAS=0.1
