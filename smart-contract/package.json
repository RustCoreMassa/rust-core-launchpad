{
  "name": "rust-core-launchpad-contracts",
  "version": "0.6.0",
  "private": true,
  "description": "RustCore Launchpad smart contracts (AssemblyScript, Massa)",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "author": "Whisky098",
  "type": "module",
  "scripts": {
    "build": "massa-as-compile",
    "test": "asp --summary",
    "clean": "rimraf build",
    "deploy": "npm run build && node --stack-size=16000 --import tsx src/deploy.ts",
    "verify": "npm run build && tsx src/verify.ts",
    "check:templates": "tsx src/check-templates.ts"
  },
  "devDependencies": {
    "@as-pect/cli": "^8.1.0",
    "@assemblyscript/loader": "^0.27.29",
    "@massalabs/as-types": "^2.1.0",
    "@massalabs/massa-as-sdk": "^3.0.2",
    "@massalabs/massa-sc-compiler": "^0.2.0",
    "@massalabs/massa-web3": "^5.3.0",
    "@massalabs/sc-standards": "1.3.0",
    "@types/node": "^24.0.0",
    "as-bignum": "^0.3.1",
    "assemblyscript": "^0.27.29",
    "dotenv": "^16.0.3",
    "tsx": "^4.7.0",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "visitor-as": {
      "assemblyscript": "$assemblyscript"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
